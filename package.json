{
  "name": "monpiz-sito",
  "version": "0.1.0",
  "private": true,
  "description": "Nuovo sito MonPiz: HTML, CSS e JavaScript senza framework.",
  "type": "module",
  "scripts": {
    "dev": "vite --host --open /html/index.html",
    "preview": "vite preview --host",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:desktop": "playwright test --project=desktop",
    "test:mobile": "playwright test --project=mobile",
    "test:links": "EXTERNAL=1 playwright test link-esterni --project=desktop",
    "test:report": "playwright show-report",
    "test:install": "playwright install chromium webkit"
  },
  "devDependencies": {
    "vite": "5.4.10",
    "@playwright/test": "^1.56.0"
  }
}
